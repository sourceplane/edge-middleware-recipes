// Committed as-is (no wiring template): the Worker binds only vars and a rate
// limiting binding, and neither carries a resource id to wire at deploy time.
// Orun deploys with `--env stage` / `--env prod`; wrangler names the Worker
// edge-middleware-recipes-recipes-<env> from the top-level name.
//
// Bindings are not inherited by environments, so `vars` and `ratelimits` are
// repeated in every env section. BASIC_AUTH_USER / BASIC_AUTH_PASSWORD are
// secrets (`wrangler secret put`, .dev.vars locally) and never appear here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edge-middleware-recipes-recipes",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "local",
    // maintenance-page: Edge Config's `isInMaintenanceMode` flag. "true" serves
    // the maintenance page for /maintenance-page/big-promo; leave it out
    // entirely to see the "missing config" dialog the upstream shows.
    "MAINTENANCE_MODE": "false"
  },
  // rate-limit-any-framework: Upstash's `Ratelimit.slidingWindow(5, "10 s")`
  // becomes the Workers Rate Limiting binding — 5 calls per 10 s per key, per
  // Cloudflare location. Bindings sharing a namespace_id share counters, so
  // each environment gets its own id.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 10 }
    }
  ],
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "dev",
        "MAINTENANCE_MODE": "false"
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 5, "period": 10 }
        }
      ]
    },
    "stage": {
      "vars": {
        "ENVIRONMENT": "stage",
        "MAINTENANCE_MODE": "false"
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 5, "period": 10 }
        }
      ]
    },
    "prod": {
      "vars": {
        "ENVIRONMENT": "prod",
        "MAINTENANCE_MODE": "false"
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 5, "period": 10 }
        }
      ]
    }
  }
}
