# Local Worker secrets for `wrangler dev`. Copy to .dev.vars (git-ignored).
# In stage/prod these are Worker secrets: `orun secrets set <NAME> --env <env>`
# (pushed to the Worker by its next deploy) or `wrangler secret put <NAME> --env <env>`.
# Unset, the basic-auth recipe answers a setup page (503) instead of a challenge.
#
# basic-auth-password: the upstream example hard-codes these two values in its
# middleware.ts and prints them on the protected page; here they are secrets.
BASIC_AUTH_USER=4dmin
BASIC_AUTH_PASSWORD=testpwd123
